{
  "name": "dsweave",
  "version": "0.0.0",
  "private": true,
  "description": "DSWeave — 空间化知识引擎：拖入文件 → Agent 理解 → 产出 3D 沉浸式知识场景",
  "type": "module",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "scripts": {
    "build": "tsc -b packages/core packages/protocol packages/agent packages/host && pnpm --filter @dsweave/web build",
    "typecheck": "tsc -b packages/core packages/protocol packages/agent packages/host && pnpm --filter @dsweave/web exec tsc --noEmit -p tsconfig.json",
    "clean": "tsc -b --clean packages/core packages/protocol packages/agent packages/host && rimraf \"packages/*/dist\" \"packages/*/.tsbuildinfo\"",
    "dev:web": "pnpm --filter @dsweave/web dev",
    "dev:host": "pnpm --filter @dsweave/host dev",
    "m2:smoke": "pnpm --filter @dsweave/host build && node packages/host/dist/smoke.js",
    "m3:smoke": "pnpm --filter @dsweave/host build && node packages/host/dist/m3-smoke.js",
    "m4b:probe": "pnpm --filter @dsweave/host build && node packages/host/dist/m4b-probe.js",
    "skills:probe": "pnpm --filter @dsweave/host build && node packages/host/dist/skills-probe.js",
    "gemini:probe": "pnpm --filter @dsweave/host build && node packages/host/dist/gemini-probe.js",
    "freeform:smoke": "pnpm --filter @dsweave/host build && node packages/host/dist/freeform-smoke.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "rimraf": "^6.0.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
